# =============================================================================
# RecoverAI — environment configuration example
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real secrets.
# =============================================================================

# ---- Server ----
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---- Database (PostgreSQL) ----
# Matches the defaults in docker-compose.yml.
DATABASE_URL=postgres://recoverai:recoverai@localhost:5432/recoverai
PGSSLMODE=disable

# ---- API authentication ----
# Protects every route EXCEPT GET /api/health, which stays public so that
# readiness probes work without credentials.
#
# Off by default so the existing test suites and local development keep
# working. A production deployment MUST set AUTH_ENABLED=true.
#
# When enabled, API_AUTH_TOKEN is REQUIRED and must be at least 16 characters.
# Startup fails otherwise: an API that appears protected but accepts every
# caller is worse than one that is openly unprotected.
#
# Callers present it as either:
#     Authorization: Bearer <token>
#     x-api-key: <token>
#
# NOTE: authentication is not authorization. A valid token decides WHO may call
# the API; the deterministic policy engine still decides whether any recovery
# action is permitted.
AUTH_ENABLED=false
# Generate with, e.g.:  openssl rand -hex 32
API_AUTH_TOKEN=

# ---- Production simulation guard ----
# RecoverAI REFUSES to start with NODE_ENV=production while either provider is
# `mock`, because every screen would fill with recovery cases, executions, and
# verified outcomes that describe nothing real.
#
# Set this to true ONLY for a deliberate demonstration deployment that performs
# no real recovery. The health endpoint reports `simulated: true` and the
# dashboard shows a simulation banner, so the state is always visible.
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# ---- AI provider ----
# One of: mock | gemini | claude | openai
# `mock` is deterministic and requires no API key — it is the default so that
# tests and the batch demo are reproducible and free to run.
#
# Selecting a real provider WITHOUT its key fails at startup. RecoverAI never
# falls back to the mock: a deployment must not appear to use a real model
# while serving deterministic stubs.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Required only when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Payment provider ----
# One of: mock | razorpay
# `mock` simulates Razorpay Test Mode semantics locally, including injectable
# timeouts for the required failure demonstration (PRD section 32).
PAYMENT_PROVIDER=razorpay
# Required only when PAYMENT_PROVIDER=razorpay. TEST MODE KEYS ONLY.
#
# RAZORPAY_KEY_ID must match rzp_test_<alphanumeric>. A live key (rzp_live_*)
# or any unrecognised format is REJECTED at startup — this system must never
# be pointed at real money.
#
# Read server-side only; never sent to the frontend, never logged.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Opt-in live provider integration tests ----
# Unset by default. When set to 1, tests that make REAL network calls to
# Razorpay Test Mode / Gemini are enabled. They are never part of the default
# suite; `npm test` makes no external calls.
RECOVERAI_LIVE_PROVIDER_TESTS=

# ---- Deterministic policy engine (PRD section 10) ----
# All financial policy lives here, NOT in the LLM prompt.
# Amounts are in the smallest currency unit (paise for INR).
POLICY_MAX_RETRY_ATTEMPTS=3
POLICY_MAX_AUTOMATED_AMOUNT=1000000
POLICY_MIN_RECOVERY_CONFIDENCE=0.75
POLICY_RETRY_COOLDOWN_SECONDS=3600
POLICY_HIGH_VALUE_THRESHOLD=1000000
POLICY_RECOVERY_WINDOW_HOURS=72
POLICY_MAX_REMINDERS_PER_PAYMENT=2

# ---- Synthetic dataset generator (PRD section 27) ----
DATASET_SEED=42
DATASET_RECORD_COUNT=1000
DATASET_EVAL_SPLIT=0.3
DATASET_AVG_TRANSACTION_VALUE=250000
DATASET_CUSTOMER_REPEAT_RATE=0.45

# ---- Demo / failure simulation (PRD section 14, 32) ----
# Fraction of executor calls the mock provider fails with an unconfirmed
# timeout, to exercise the safe-failure path. Set 0 to disable.
DEMO_API_TIMEOUT_RATE=0.05
