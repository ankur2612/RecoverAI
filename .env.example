# =============================================================================
# RecoverAI — environment configuration example
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real secrets.
# =============================================================================

# ---- Server ----
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---- Database (PostgreSQL) ----
# Matches the defaults in docker-compose.yml.
DATABASE_URL=postgres://recoverai:recoverai@localhost:5432/recoverai
PGSSLMODE=disable

# ---- AI provider ----
# One of: mock | claude | openai
# `mock` is deterministic and requires no API key — it is the default so that
# tests and the batch demo are reproducible and free to run.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Payment provider ----
# One of: mock | razorpay
# `mock` simulates Razorpay Test Mode semantics locally, including injectable
# timeouts for the required failure demonstration (PRD section 32).
PAYMENT_PROVIDER=mock
# Required only when PAYMENT_PROVIDER=razorpay. TEST MODE KEYS ONLY.
# These are read server-side only and must never reach the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Deterministic policy engine (PRD section 10) ----
# All financial policy lives here, NOT in the LLM prompt.
# Amounts are in the smallest currency unit (paise for INR).
POLICY_MAX_RETRY_ATTEMPTS=3
POLICY_MAX_AUTOMATED_AMOUNT=1000000
POLICY_MIN_RECOVERY_CONFIDENCE=0.75
POLICY_RETRY_COOLDOWN_SECONDS=3600
POLICY_HIGH_VALUE_THRESHOLD=1000000
POLICY_RECOVERY_WINDOW_HOURS=72
POLICY_MAX_REMINDERS_PER_PAYMENT=2

# ---- Synthetic dataset generator (PRD section 27) ----
DATASET_SEED=42
DATASET_RECORD_COUNT=1000
DATASET_EVAL_SPLIT=0.3
DATASET_AVG_TRANSACTION_VALUE=250000
DATASET_CUSTOMER_REPEAT_RATE=0.45

# ---- Demo / failure simulation (PRD section 14, 32) ----
# Fraction of executor calls the mock provider fails with an unconfirmed
# timeout, to exercise the safe-failure path. Set 0 to disable.
DEMO_API_TIMEOUT_RATE=0.05
